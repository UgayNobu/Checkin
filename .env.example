# Used by docker-compose.yml (local Docker stack). Copy to .env and fill in.
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Optional (these are the defaults)
# APP_PORT=8080
# POSTGRES_USER=checkin_user
# POSTGRES_PASSWORD=checkin_dev_password
# POSTGRES_DB=checkin_db
# GEOFENCE_METRES=40
# ACCURACY_FLAG_METRES=150

# Email (optional; Gmail app password, never commit it)
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=your.account@gmail.com
# SMTP_PASS=your-16-letter-app-password
