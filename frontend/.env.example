# Backend API base URL (change the port if the backend runs elsewhere, e.g. 5001 on macOS)
# Next.js reads NEXT_PUBLIC_* variables from frontend/.env.local (this replaces VITE_API)
NEXT_PUBLIC_API=http://localhost:5001/api
# Phone demo through a tunnel: use NEXT_PUBLIC_API=/api — Next forwards /api to BACKEND_URL (next.config.mjs)
# BACKEND_URL=http://localhost:5001
