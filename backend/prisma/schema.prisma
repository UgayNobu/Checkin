generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Department {
  id        String    @id @default(dbgenerated("gen_id('D'::text, 'seq_departments'::text)")) @map("department_id") @db.VarChar(10)
  code      String    @unique(map: "uq_departments_code") @map("department_code") @db.VarChar(10)
  name      String    @unique(map: "uq_departments_name") @map("department_name") @db.VarChar(100)
  website   String?   @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at")
  programs  Program[]

  @@map("departments")
}

model Program {
  id            String      @id @default(dbgenerated("gen_id('P'::text, 'seq_programs'::text)")) @map("program_id")
  name          String      @map("program_name")
  departmentId  String?     @map("department_id") @db.VarChar(10)
  level         String?     @db.VarChar(10)
  durationYears Int?        @map("duration_years")
  department    Department? @relation(fields: [departmentId], references: [id], onUpdate: Cascade, onDelete: SetNull, map: "fk_programs_department")
  modules       Module[]

  @@map("programs")
}

model User {
  id            String             @id @map("user_id")
  name          String?
  email         String             @unique
  passwordHash  String?            @map("password_hash")
  role          String
  phone         String?
  department    String?
  designation   String?
  programme     String?
  year          Int?
  isActive      Boolean            @default(true) @map("is_active")
  status        String             @default("active") @db.VarChar(10)
  avatarUrl     String?            @map("avatar_url") @db.VarChar(255)
  updatedAt     DateTime           @default(now()) @updatedAt @map("updated_at")
  prefs         Json               @default("{}") @map("notification_prefs")
  createdAt     DateTime           @default(now()) @map("created_at")
  sections      Section[]
  attendance    Attendance[]
  enrollments   Enrollment[]
  evidence      EvidenceDocument[] @relation("EvidenceStudent")
  reviewed      EvidenceDocument[] @relation("EvidenceReviewer")
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Module {
  id           String             @id @default(dbgenerated("gen_id('M'::text, 'seq_modules'::text)")) @map("module_id")
  code         String             @unique @map("module_code")
  name         String             @map("module_name")
  programId    String             @map("program_id")
  year         Int?
  semester     Int?
  enrolmentKey String?            @map("enrolment_key")
  moduleCount  Int?               @map("module_count")
  program      Program            @relation(fields: [programId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  sections     Section[]
  enrollments  Enrollment[]
  evidence     EvidenceDocument[]

  @@map("modules")
}

model Section {
  id       String         @id @default(dbgenerated("gen_id('SEC'::text, 'seq_sections'::text)")) @map("section_id")
  moduleId String         @map("module_id")
  tutorId  String         @map("tutor_id")
  name     String?        @map("section_name")
  room     String?
  schedule String?
  module   Module         @relation(fields: [moduleId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  tutor    User           @relation(fields: [tutorId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  sessions ClassSession[]

  @@map("sections")
}

model ClassSession {
  id          String           @id @default(dbgenerated("gen_id('S'::text, 'seq_sessions'::text)")) @map("session_id")
  sectionId   String           @map("section_id")
  date        DateTime         @db.Date
  startTime   DateTime         @map("start_time") @db.Time(6)
  duration    Int
  sessionType String?          @map("session_type")
  status      String           @default("scheduled") @db.VarChar(20)
  section     Section          @relation(fields: [sectionId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  codes       AttendanceCode[]
  attendance  Attendance[]

  @@map("class_sessions")
}

model AttendanceCode {
  sessionId       String       @map("session_id")
  code            String
  expiryTimestamp DateTime     @map("expiry_timestamp")
  geofenceRadius  Float        @map("geofence_radius")
  latitude        Float
  longitude       Float
  session         ClassSession @relation(fields: [sessionId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([sessionId, code])
  @@map("attendance_codes")
}

model Attendance {
  id        String       @id @default(dbgenerated("gen_id('A'::text, 'seq_attendance'::text)")) @map("attendance_id")
  studentId String       @map("student_id")
  sessionId String       @map("session_id")
  timestamp DateTime?    @default(now())
  status    String       @default("Absent")
  submittedLat   Float?  @map("submitted_lat")
  submittedLng   Float?  @map("submitted_lng")
  accuracy       Float?
  distanceMeters Float?  @map("distance_meters")
  flagReason     String? @map("flag_reason") @db.VarChar(100)
  student   User         @relation(fields: [studentId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  session   ClassSession @relation(fields: [sessionId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@unique([studentId, sessionId])
  @@map("attendance")
}

model Enrollment {
  studentId    String   @map("student_id")
  moduleId     String   @map("module_id")
  enrolledDate DateTime @default(now()) @map("enrolled_date") @db.Date
  student      User     @relation(fields: [studentId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  module       Module   @relation(fields: [moduleId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@id([studentId, moduleId])
  @@map("enrollments")
}

model EvidenceDocument {
  id          String   @id @default(dbgenerated("gen_id('E'::text, 'seq_evidence'::text)")) @map("evidence_id")
  studentId   String   @map("student_id")
  moduleId    String   @map("module_id")
  date        DateTime @db.Date
  reason      String?
  documentUrl String?  @map("document_url")
  status      String   @default("Pending")
  reviewedBy  String?  @map("reviewed_by")
  leaveType   String?  @map("leave_type")
  originalFilename String?   @map("original_filename") @db.VarChar(255)
  reviewedAt       DateTime? @map("reviewed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  student     User     @relation("EvidenceStudent", fields: [studentId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  module      Module   @relation(fields: [moduleId], references: [id], onUpdate: Cascade, onDelete: Restrict)
  reviewer    User?    @relation("EvidenceReviewer", fields: [reviewedBy], references: [id], onUpdate: Cascade, onDelete: SetNull)

  @@map("evidence_documents")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_id('N'::text, 'seq_notif'::text)")) @map("notification_id")
  userId    String   @map("user_id")
  message   String
  category  String
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_id('L'::text, 'seq_audit'::text)")) @map("log_id")
  adminId   String   @map("admin_id")
  action    String
  details   String?
  timestamp DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id], onUpdate: Cascade, onDelete: Restrict)

  @@map("audit_logs")
}