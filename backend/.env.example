# Supabase connection (ask the team lead for real values; never commit .env)
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
JWT_SECRET="change-me"
PORT=5001
# Check-in radius around the tutor. 40 m = classroom (13 m measured) + indoor GPS error (~25 m)
GEOFENCE_METRES=40
# A timetable class can be started this many minutes before it begins (until it ends)
START_EARLY_MINUTES=15
# Attendance rules (optional; these are the defaults)
REQUIRED_ATTENDANCE_PERCENT=90
AT_RISK_ATTENDANCE_PERCENT=80
# A location reading less precise than this (metres) is flagged for the tutor. 150 suits laptops and indoor phones
ACCURACY_FLAG_METRES=150
# Minutes the tutor has to decide flagged students after the 2-minute check-in code closes
REVIEW_MINUTES=3
LOW_ATTENDANCE_REALERT_DAYS=7
CHECKIN_WINDOW_MINUTES=5
NETWORK_GRACE_SECONDS=120

# Optional extras (leave empty if not used)
# FRONTEND_URL=http://localhost:5173
# JWT_EXPIRES_IN=8h
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=checkin-files
# Email (needed for "Forgot password" codes). With Gmail: turn on 2-step verification,
# create an App password (Google Account > Security > App passwords) and use it as SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your.account@gmail.com
# SMTP_PASS=your-16-letter-app-password
# MAIL_FROM=CheckIn <your.account@gmail.com>
# Check it works:  npm run mail:test -- someone@example.com

# Tutor accounts are created by the admin (Admin > Tutors). New tutors get this password
# and are asked to change it after their first login. Must have upper + lower case, a number and a symbol.
# DEFAULT_TUTOR_PASSWORD=CheckIn@2026

# SMS (optional). Leave empty to send email + in-app notifications only.
# Users turn SMS on in Settings and need a phone number in their profile.
# Twilio:
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
# TWILIO_FROM=+15551234567
# Or any HTTP SMS gateway (gets a JSON POST { "to": "+975...", "message": "..." }):
# SMS_PROVIDER=http
# SMS_HTTP_URL=https://gateway.example.com/send
# SMS_HTTP_TOKEN=xxxxxxxx
