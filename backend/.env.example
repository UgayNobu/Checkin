# Supabase connection (ask the team lead for real values; never commit .env)
DATABASE_URL="postgresql://USER:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"
JWT_SECRET="change-me"
PORT=5000
GEOFENCE_METRES=10

# Attendance rules (optional; these are the defaults)
REQUIRED_ATTENDANCE_PERCENT=90
AT_RISK_ATTENDANCE_PERCENT=80
ACCURACY_FLAG_METRES=50
LOW_ATTENDANCE_REALERT_DAYS=7
